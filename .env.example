# Supabase Configuration
SUPABASE_URL=https://your-supabase-url.supabase.co
SUPABASE_KEY=your-supabase-service-key
SUPABASE_ANON_KEY=your-supabase-anon-key

# OpenAI Configuration
OPENAI_API_KEY=your-openai-api-key

# Application Settings
APP_ENVIRONMENT=development  # development, staging, production
LOG_LEVEL=INFO  # DEBUG, INFO, WARNING, ERROR, CRITICAL

# File Upload Settings
MAX_UPLOAD_SIZE_MB=10
ALLOWED_EXTENSIONS=pdf

# RAG Settings
MAX_CHUNK_SIZE=1000  # Maximum tokens per chunk
DEFAULT_RETRIEVAL_COUNT=5  # Number of chunks to retrieve
DEFAULT_HANDOVER_THRESHOLD=0.7  # Default confidence threshold for handover

# Render Deployment Settings (if using Render)
RENDER_WEB_CONCURRENCY=4